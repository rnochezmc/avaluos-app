rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /avaluos/{document=**} {
      // Permitir lectura y escritura de avalúos
      allow read, write: if true;
    }
    match /usuarios/{document=**} {
      // Permitir lectura y gestión de usuarios
      allow read, write: if true;
    }
  }
}
